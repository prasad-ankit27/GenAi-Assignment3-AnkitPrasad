   "source": [
    "def factorial(n):\n",
    "    if (n==0 or n==1):\n",
    "        return 1\n",
    "    elif(n<0):\n",
    "        print(\"Enter any positive number!\")\n",
    "    else:\n",
    "        return n*factorial(n-1)\n",
    "\n",
    "factorial(5)\n",
    "factorial(0)\n",
    "factorial(-3)"
   ]
