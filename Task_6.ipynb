   "source": [
    "prices=[100,500,900,50,750]\n",
    "discount=lambda x:x-x*10/100\n",
    "discounted_prices=(list(map(discount,prices)))\n",
    "print(\"Discounted prices:\",discounted_prices)\n",
    "print('Filtered prices:',list(filter(lambda x:x>300,discounted_prices)))\n"
   ]
